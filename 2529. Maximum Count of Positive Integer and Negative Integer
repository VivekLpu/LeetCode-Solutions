class Solution {
    public int maximumCount(int[] nums) {
        int positiveInteger = 0;
        int negativeInteger = 0;
        // int max = 0;

        for(int n : nums){
            if(n > 0){
                positiveInteger++;
            }else if(n < 0){
                negativeInteger++;

            }
        }
        int max = Math.max(positiveInteger,negativeInteger);
        return max;
        
    }
}

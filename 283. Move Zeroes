class Solution {
    public void moveZeroes(int[] nums) {
        int len = nums.length;
        int i=0;
        for(int j=0; j<len; j++){
            if(nums[j] != 0){
                nums[i] = nums[j];
                i++;
            }
        }

        while(i<len){
            nums[i] = 0;
            i++;
        }
    }
}

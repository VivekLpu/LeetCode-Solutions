class Solution {
    public int stoneGameV(int[] stoneValue) {
        int totalSum = 0;
        int n = stoneValue.length;

        return helper(0, n-1, stoneValue);
    }

    private int helper(int left, int right, int[] stoneValue){
        if(left == right) return 0;

        int totalSum = 0;

        for(int i=left;i<=right;i++){
            totalSum += stoneValue[i];
        }

        int leftSum = 0;
        int rightSum = 0;

        int maxScore = 0;

        for(int i=left;i<=right-1;i++){
            leftSum += stoneValue[i];
            rightSum = totalSum-leftSum;
            
            if(leftSum == rightSum){
                int l = leftSum + helper(i+1, right, stoneValue);
                int r = rightSum + helper(left, i, stoneValue);
                maxScore = Math.max(maxScore, Math.max(l, r));
            }
            else if(leftSum < rightSum){
                maxScore = Math.max(maxScore ,leftSum+helper(left, i, stoneValue));
            }
            else{
                maxScore = Math.max(maxScore, rightSum + helper(i+1, right, stoneValue));
            }
        }
        
        return maxScore;
    }
}

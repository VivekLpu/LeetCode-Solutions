class Solution {
    public int[] twoSum(int[] nums, int target) {
        int len = nums.length;
        int end = len -1;
        int start = 0;

        while(start<end){
            if (nums[start]+nums[end] == target){
                return new int[] {start,end};
            }
            else if(target < nums[start]+nums[end]){
                end--;
            }else{
                start++;
            }
        }
        return new int[]{};
    }
}

